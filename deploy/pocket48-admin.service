[Unit]
Description=Pocket48 Operations Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pocket48-bot
ExecStart=/root/pocket48-bot/pocket48-admin
Environment=POCKET48_ADMIN_ADDR=127.0.0.1:8787
Environment=POCKET48_CONFIG_PATH=/root/pocket48-bot/config.json
Environment=POCKET48_LOG_PATH=/root/pocket48-bot/bot.log
Environment=POCKET48_ADMIN_PASSWORD_FILE=/root/pocket48-bot/storage/admin-password
Environment=POCKET48_ADMIN_COOKIE_PATH=/
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
